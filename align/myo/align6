 set aa [string range $seq1 $i $i]
 if { [string equal $aa "-"] } {
  set out1 "$aa    "
 } else {
  set out1 "[incr counter1] $aa"
 }
 set aa [string range $seq2 $i $i]
 if { [string equal $aa "-"] } {
  set out2 "$aa    "
 } else {
  set out2 "[incr counter2] $aa"
 }
 set aa [string range $seq3 $i $i]
 if { [string equal $aa "-"] } {
  set out3 "$aa    "
 } else {
  set out3 "[incr counter3] $aa"
 }
