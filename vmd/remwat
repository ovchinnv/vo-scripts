#!/bin/vmd
mol delete all

set fpath .
set psffile $fpath/struc/dhfr_sn
mol load psf ${psffile}.psf

set solute  [atomselect top "protein"];
set solvent [atomselect top "not protein"];

set nowfile $fpath/dhfr-now.dcd
set nowfiles {}
set step 1
set ifile 0
set efile 3
set flag eq
for { set i $ifile } { $i <= $efile } { incr i } {
 if { $i > 0 } { set flag nvt } ;
# read dcd
 set dcdfile $fpath/dhfr${i}${flag}
 animate read  dcd $dcdfile.dcd beg 0 skip $step waitfor all
 animate write dcd ${dcdfile}_now.dcd beg 0 skip 1 waitfor all sel $solute
 lappend nowfiles ${dcdfile}_now
  animate delete all
}

foreach dcdfile $nowfiles {break;}
puts "appending file $dcdfile ..."
exec catdcd -o $nowfile.dcd $dcdfile.dcd
exec rm -f $dcdfile.dcd
#
for { set i 1 } { $i < [llength $nowfiles] } { incr i } {
 set dcdfile [lindex $nowfiles $i];
 puts "appending file $dcdfile ..."
 exec mv $nowfile.dcd temp
 exec catdcd -o $nowfile.dcd temp $dcdfile.dcd
 exec rm -f $dcdfile.dcd
}
exec rm -f temp.dcd
