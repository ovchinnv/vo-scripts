file=ftsm_var.mod ; \
dir=../ftsm/ ; \
if [ -f $file ] ; then mv -f $file ../ftsm/ftsm_var.mod 2>/dev/null; touch -m ../ftsm/ftsm_var.mod 2>/dev/null; else \
FILE=`echo ${file%.*} | tr '[:lower:]' '[:upper:]'`.mod ; \
if [ -f $FILE ] ; then mv -f $FILE $dir/$FILE 2>/dev/null; \
touch -m $dir/$FILE 2>/dev/null;\
fi ; fi
