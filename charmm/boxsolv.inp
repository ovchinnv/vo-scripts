* protein solvation component
*

set clib ~/scripts/charmm

!set adpar ../inhib/@{drugfile}/@{drugfile}i
!set cgenff

stream @{clib}/readpsf36.str

if @?buf eq 0 set buf 11.  ! solvation radius

if @?solute eq 0 set solute all
define solute select ( @solute ) end
coor orie select solute end ! align 
coor stat select solute end ! select the active site region

! compute center of water box
calc xmin = ?xmin
calc ymin = ?ymin 
calc zmin = ?zmin 
calc xmax = ?xmax
calc ymax = ?ymax 
calc zmax = ?zmax 
!include xwat in solvation
define solute select all end
update atom cutnb 15 ctonnb 10 ctofnb 12 vdw vshift fshift cdie

nobomb
if @?overlap eq 0 set overlap 2.5
!stream wbox.str
stream @{clib}/wcube.str
rename segid wat select segid w* end ! rename all waters

!goto write ! skip minimization

cons harm force 30 select solute .and. .not. hydrogen end
! cons fix select onlysolute .and. .not. hydrogen end
! mini sd nstep 100
mini conj nstep 10
mini abnr nstep 10
 
label unconstrained_mini ! no constraints in reaction zone 
cons harm clear
mini conj nstep 10
minimize abnr nstep 10


label skipmini
energy

label write

write psf @format name @{psffile}_s.psf
write coord @format name @{corfile}s.cor
write coord pdb name @{corfile}s.pdb
* solvated in a box of dimension
* xmin=@xmi ymin=@ymi zmin=@zmi 
* xmax=@xma ymax=@yma zmax=@zma 
*
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
open write card unit 66 name @{psffile}.str
write title unit 66
** solvated in an orthorhombic box of the following dimensions
* set a  @xl
* set b  @yl
* set c  @zl
close unit 66

!!!! STOP HERE !!!!!!!!!!!

goto kill

!!!!!!!!! FINISHED !!!!!!!!!!!!

label kill
stop
