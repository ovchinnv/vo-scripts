* apply restraints to protein phi & psi angles to
* keep them near alpha helical values
*

!cons cldh

if @?dphi eq 0 calc dphi = 7 / 180 * ?pi

define todo sele (@{alphas}) end
if ?nsel eq 0 then
 error nothing to do
endif

if @?kfalpha eq 0  set kfalpha 100 ! the restraints should be as weak as possible (but effective)

label rloop

set residi ?selresi
set segidi ?selsegi

! next residue :
define todo sele todo .and. .not. ( segid @segidi .and. resid @residi ) end

set residj ?selresi
set segidj ?selsegi
set resname ?selresn

if @resname .eq. PRO goto skip
if @segidj .ne. @segidi goto skip

cons dihe @segidi @residi C @segidj @residj N @segidj @residj CA @segidj @residj C min -57 period 0 width @dphi force @kfalpha ! phi
cons dihe @segidi @residi N @segidi @residi CA @segidi @residi C  @segidj @residj N min -47 period 0 width @dphi force @kfalpha ! psi

label skip
if ?nsel gt 0 -
goto rloop
