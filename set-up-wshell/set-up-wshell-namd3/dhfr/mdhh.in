#!/bin/vmd
set psffile struc/dhfr_snhh.psf
set pdbfile struc/dhfr_msn.pdb
set resfile struc/dhfr_msn.pdb
set temperature 300
set cutoff 9
set switchdist 8
set pairlistdist 12
set margin 2
set a 63
set b 63
set c 63
temperature $temperature
set shake all
set dt 4.0
set pme off
#set pmefreq 2
#set pressurefreq 20
set parameters struc/dhfr36.par
set cswitch off
set nsteps 100000
set freq 10000
set outputName scratch/dhfr0npt
set lang on
set lfriction 1
set baro off
set bptime 500
set ministeps 100
DynamoPlugin on
DynamoConfigFile watershell0.in
DynamoLogFile watershell0.log
#!/bin/vmd
GPUResident on
#############################################################
structure          $psffile
coordinates        $pdbfile
#
#
if [info exists xscfile] {
  set fd [open $xscfile r]
  while { [gets $fd line] > -1 } { 
   set a [lindex $line 1];
   set b [lindex $line 5];
   set c [lindex $line 9];
  }
  close $fd
#
#print "$a $b $c" ;
#
}
paratypecharmm on
parameters          ${parameters}

# Force-Field Parameters
exclude             scaled1-4
1-4scaling          1.0
cutoff              $cutoff
switching           on
switchdist          $switchdist
pairlistdist        $pairlistdist ; # does not always help
margin              $margin
#
if [info exists pmefreq] {
fullelectfrequency  $pmefreq
}
if [info exists nbondfreq] {
 nonbondedfreq      $nbondfreq
}
if [info exists pressurefreq] {
 berendsenpressurefreq      $pressurefreq
}
if [info exists stepspercycle] {
 stepspercycle      $stepspercycle
}

# Integrator Parameters
timestep            $dt  ;# fs

rigidbonds          $shake  ;# needed for 2fs steps
ignoremass          yes ;# do not identify hydrogens based on mass

constraints         $cswitch
consref             $resfile ;# reference positions file
conskfile          $resfile
if [info exists conskcol] {
  conskcol          $conskcol
}
# Constant Temperature Control
langevin            $lang    ;# do langevin dynamics
#langevinFile        $resfile
#langevinCol         Z
langevindamping     $lfriction     ;# damping coefficient (gamma)
langevintemp        $temperature
#langevinHydrogen    off    ;# don't couple langevin bath to hydrogens
#berendsenpressure   $baro
#berendsenpressuretarget 1.01325
#berendsenpressurerelaxationtime $bptime
#berendsenpressurecompressibility 0.0000457
vdwforceswitching   on ;# CHARMM vdw force switching function
#
#############################################################
## OUTPUT PARAMETERS                                       ##
#
outputname          $outputName
restartfreq         [expr {$freq*5} ]; # make less frequent to decrease likelihood of repeat craches
dcdfreq             $freq
xstFreq             $freq
outputEnergies      $freq
#outputPressure      $freq
outputTiming        $freq
#########################################################################
# Periodic Boundary Conditions
# PME (for full-system periodic electrostatics)
pme                 $pme
if { $pme == "on" } {
 pmegridspacing      1.0

 set sx $a
 set sy $b
 set sz $c

 cellBasisVector1     $sx               0.                          0.
 cellBasisVector2     0.                $sy                         0.
 cellBasisVector3     0.                0.                          $sz
 cellOrigin           0.                0.                          0.
};


############################################################################
# Run
# minimization
minimize $ministeps

# dynamics
run $nsteps
