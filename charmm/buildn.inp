* build structure files
*

if @?version eq 0 set version 36

if @?clib eq 0 set clib ~/scripts/charmm

if @?nopar eq 0 stream @{clib}/readpsf36.str

if @?nseg eq 0 set nseg 1

set iseg 1
label segloop

set nm @segid@@{iseg}

if @?file@@{iseg} eq 0 then
 set file @{nm}
else
 set file @file@@{iseg}
endif

if @?seqfile@@{iseg} eq 0 then
 set seqfile @{nm}
else
 set seqfile @seqfile@@{iseg}
endif

if @?npatch@@{iseg} eq 0 then
 set pfirst none
else
 set pfirst @npatch@@{iseg}
endif

if @?cpatch@@{iseg} eq 0 then
 set plast none
else
 set plast @cpatch@@{iseg}
endif

if @?gen@@{iseg} eq 0 then
 set egen
else
 set egen @gen@@{iseg}
endif

read sequ pdb name "@SEQFILE.pdb"
generate @{nm} setup warn first @pfirst last @plast @egen
! apply patches, if supplied
if @?patchfile ne 0 then
 stream @patchfile
 autogen angl dihe
endif
!
!
set last ?nres
!
if @?fixpdb ne 0 then
 rename atom CD1 sele type CD .and. resname ILE end ! could already be done in getchain
 rename atom O sele type OT1  .and. resid @last end
 rename atom OXT sele type OT2  .and. resid @last end
endif

read coor pdb name "@FILE.pdb" resid
! to orient with a reference structure
if @?refpdb@@{iseg} ne 0 then
 read coor pdb name @refpdb@@{iseg} resid comp
 coor swap sele segid @nm end
 coor orie rms mass comp sele segid @nm end
 coor swap sele segid @nm end
endif

if @?fixpdb ne 0 then
 rename atom CD  sele type CD1 .and. resname ILE end
 rename atom OT1 sele type O  .and. resid @last end
 rename atom OT2 sele type OXT  .and. resid @last end
endif

! to renumber residues:
if @?qrenu eq 1 join @nm renu

incr iseg by 1

if @iseg le @nseg -
goto segloop


! missing
print coor sele .not. ( init .or. hydrogen ) end
! add disulfides
if @?qdisu ne 0 stream @{clib}/disu.str
!autogen angl dihe

define xray sele init end
scalar wmain set 1 sele xray end
print coor select .not. (init .or. hydrogen) end

ic param
ic fill preserve
ic build
print coor select .not. (init .or. hydrogen) end

coor init sele hydro end

hbuild
print coor sele .not. init end

energy

open unit 7 card name @{output}.psf
write psf card unit 7
open unit 7 card name @{output}.cor
write coor card unit 7
open unit 7 card name @{output}.pdb
write coor pdb unit 7
close unit 7
