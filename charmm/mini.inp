* build structure files
*

set version 36

if @?psffile eq 0 set psffile @name
if @?corfile eq 0 set corfile @psffile

if @?clib eq 0 set clib ~/scripts/charmm
stream @{clib}/readpsf36.str

if @?qfacts ne 0 stream @{clib}/facts.str

coor copy comp

! reason to use wcomp is that, with FACTS, wmain is overwritten with radii
cons harm sele prop wcomp .eq. 1 end force 200

set imini 1
set nmini 5

label mini

mini sd nstep 20
mini conj nstep 20
mini abnr nstep 10

coor chir check fix

incr imini
if @imini lt @nmini goto mini

cons harm sele prop wcomp .eq. 1 end force 10

set imini 1
set nmini 5

label mini2

mini sd nstep 20
mini conj nstep 20
mini abnr nstep 10

coor chir check fix

incr imini
if @imini lt @nmini goto mini2

if @?qnores ne 0 cons harm clear

mini abnr nstep 100

write coor card name @corfile_m.cor

coor orie rms mass


