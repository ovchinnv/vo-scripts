! charmm
! watershell input script
!
 output {
  minwarnlev=-1
 }


 watershell {

  structure_file=struc/4f23-fld3-498m-bmass.pdb

  radii=file
  radiifile=struc/4f23-fld3-498m-bmass.pdb
  radiifiletype=PDB
  radiicol=O

  dasystat=yes
  mass=file
  massfile=struc/4f23-fld3-498m-bmass.pdb
  massfiletype=PDB
  masscol=B
! dasystat params (defaults, so commented out) :
!  density_relax_time=100
!  density_update_freq=500
!  distance_update_freq=100

!  structure_update_memo=0.9999 ! closer to 1 for flexible structures
  structure_update_freq=7
  surface_force_constant=10 ! 1 and above seems to be reasonable
  surface_distance=0 ! to guess automatically

!  full_sum_freq=100
!  remove_net_torque=yes
!  remove_net_force=no ! yes by default if remove_net_torque = on
!  net_force_ave_update_memo=0.9d0 ! 0 by default

  rigid_body_restraint=yes
  rigid_body_force_constant=10

!  neighbor_list=yes

! use a simple minimum distance algorithm
  minimum_distance=yes

! more aggressive params to increase speed (only for erf method)
!  cutoff_surf_stdev=4

  surface_atoms="ANAME=CA OR ANAME=O5"
  solvent_atoms="ANAME=OH2 OR ANAME=SOD OR ANAME=CLA"

  restart_file=@{restart_file}
  output_file=@{output_file}

  output_freq=10000

 }
