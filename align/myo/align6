#!/usr/bin/tclsh

set fid  [open "0myo6" r];
set fido [open "seqal6" w];

set keyword "NULL";

puts $fido "1VOM \t 2BKH \t 1OE9"

set nseq 3;
set counter1 0;
set counter2 0;
set counter3 0;
#set counter4 0;
#set counter5 0;
#set counter6 0;

while { [gets $fid line1] > -1} { 
   set keyword [string range $line1 0 10]
   while { ([lsearch -exact $keyword "MYS2_DICDI"] < 0) } {
     gets $fid line1  
     set keyword [string range $line1 0 10]
   }
# found !

gets $fid line2
gets $fid line3
