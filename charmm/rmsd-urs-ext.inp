* alanine dipeptide
* RMSDs computed using uniform rotational sampling (rotations generated externally)
*

set nbox 10 ! periodic box length (Ang)

set version 22
set toppar ~/charmm/parameters/c36
stream ~/scripts/charmm/readpsf.str

read sequence card
1
ALAD

generate dial setup warn
write psf card name diala22.psf
! generate coordinates
IC PARA
IC SEED 1 CLP 1 NL 1 CA
IC BUILD
!
!minimize 
mini sd nstep 10
mini conj nstep 10
mini abnr nstep 10
coor orient mass
coor copy comp ! save coordinates
!
!
! use string method restraints

mcom string 1 by 1
set s string smcv
@s init

!define com restraint
!define restrained sele type CB end
define restrained sele all end
!
@s add rmsd orient sele restrained end rmsd sele restrained end noro mass ! need mass weighting to get HOs with same frequency (see confinement paper)
@s fill ! reference coords are the same as instant, so should be zero
@s print
!@s test grad

! set force constant(s)
@s set force 0 all
! set statistics options
set fout rms_urs_ext.dat
open form write name "@FOUT" unit 1
write title unit 1
*%rmsd computed in charmm script file rmsd-urs-ext.inp
@s stat hist hnam @fout hcol inst happ ! output cv history appending to file
! now loop over rotations in external file
!set fin rotations.dat
set nrot 200 ! number of rotations to read from file
set qinternal 1 ! whether to read a first, which I arbitrarly called "internal" rotation
set type rand ! how angles were generated, can be rand or grid
!set type grid
set fin rotations-@{type}-@{nrot}.dat
set irot 1
set jrot 1 ! output indicator
open form read name "@FIN" unit 1
prnlev 1
label lrot
if @qinternal eq 1 then
! first rotation
 get unit 1 x
 get unit 1 y
 get unit 1 z
 get unit 1 phi
 coor rota xdir @x ydir @y zdir @z phi @phi
endif
! second rotation
 get unit 1 x
 get unit 1 y
 get unit 1 z
 get unit 1 phi
 coor rota xdir @x ydir @y zdir @z phi @phi
! compute rmsd
 @s hist add
 if @jrot .eq. 1000 then
  set jrot 0
  @s stat ! write history
 endif
!
 coor copy ! restore original coordinates
 incr irot
 incr jrot
 if @irot le @nrot -
goto lrot

@s stat
prnlev 5
