#!/bin/vmd

package require pbctools

mol delete all
set name adk1-dp
mol load psf ../struc/ak1-d_sn.psf
mol addfile  ../struc/ak1-dsn.pdb

set itraj 10
set etraj 29

set step 10
for {set i $itraj } { $i <= $etraj } {incr i} {
 mol addfile ./${name}${i}nvt.dcd waitfor all step $step
}
mol addfile output.dcd waitfor all step $step

#source unwrap.vmd ; # should be safe to omit because only the ligands jump across box

set id [ molinfo top ];
set nf [molinfo $id get numframes];
#set selection "protein or resname GTP or resname MG"
set orientation "protein" ;
set rms "protein" ;
set cons "beta 1 and backbone"
#set cons "beta 1"
#set cons "noh"

set all      [atomselect $id all];
set orient   [atomselect $id "$orientation and $cons"]
set template [atomselect $id "$orientation and $cons" frame 0] 
set rmsd     [atomselect $id "$rms and $cons"]
set ref      [atomselect $id "$rms and $cons" frame 0] 
#
#
set fid [open "rmsd.dat" w+];
set rms_ {};
#
for { set i 0 } { $i<$nf } { incr i } {
 $orient frame $i
# $orient update
 $rmsd frame $i
# $rmsd update
 $all frame $i
# $all update
 $all move [measure fit $orient $template]
 set r [measure rmsd $rmsd $ref];
 lappend rms_ $r
 puts $fid "$r"
}
close $fid
#
puts ${rms_}
