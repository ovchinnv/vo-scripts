* build structure files
*

set version 36

set psffile @name
set corfile @psffile

if @?clib eq 0 set clib ~/scripts/charmm
stream @{clib}/readpsf36.str

coor copy comp

cons harm sele prop wmain .eq. 1 end force 200

set imini 1
set nmini 5

label mini

mini sd nstep 20
mini conj nstep 20
mini abnr nstep 10

coor chir check fix

incr imini
if @imini lt @nmini goto mini

cons harm sele prop wmain .eq. 1 end force 10

set imini 1
set nmini 5

label mini2

mini sd nstep 20
mini conj nstep 20
mini abnr nstep 10

coor chir check fix

incr imini
if @imini lt @nmini goto mini2

mini abnr nstep 20

write coor card name @corfile_m.cor

coor orie rms mass
