* apply restraints to protein omega angles to
* keep them near the trans conformation
*

cons cldh


define todo sele (@{omegas}) end
if ?nsel eq 0 then
 error nothing to do
endif

if @?kfcis eq 0  set kfcis 100 ! the restraints should be as weak as possible (but effective)

label rloop

set residi ?selresi
set segidi ?selsegi

! next residue :
define todo sele todo .and. .not. ( segid @segidi .and. resid @residi ) end

set residj ?selresi
set segidj ?selsegi
set resname ?selresn

if @?noproskip .eq. 1 goto noproskip
if @resname .eq. PRO goto skip
label noproskip
if @?nosegskip .eq. 1 goto nosegskip
if @segidj .ne. @segidi goto skip ! assume no connection
label nosegskip
cons dihe @segidi @residi CA @segidi @residi C @segidj @residj N @segidj @residj CA min 180 force @kfcis
label skip
if ?nsel gt 0 -
goto rloop
