##############################################################
########## domain definitions from Anne Houdusse #############

atomselect macro SH3     {resid 34 to 77 }
atomselect macro Nterm   {resid 78 to 200 or resid 648 to 677 }


atomselect macro Ploop   {resid 178 to 185}
atomselect macro Loop1   {resid 202 to 210}

atomselect macro Switch1 {resid 228 to 238}

atomselect macro U50Lp2 {resid 613 to 628}
atomselect macro U50 {resid 218 to 440 or resid 595 to 612 or U50Lp2}

atomselect macro HCMLoop {resid 397 to 409}
# actually, the HCM loop goes to 391; this shows adjoining a-helix

atomselect macro Switch2 {resid 454 to 465}
atomselect macro L50 {resid 465 to 589 or resid 629 to 647}
atomselect macro RelayH   {resid 466 to 498} ;# 484
atomselect macro RelayL   {resid 498 to 511}
atomselect macro Relay {RelayH or RelayL}

atomselect macro Strut   {resid 589 to 594}

atomselect macro SH2Loop {resid 678 to 680}
atomselect macro SH1Helix {resid 680 to 690}
atomselect macro SH1Loop {resid 691 to 693}


atomselect macro Converter {resid 694 to 707 or resid 735 to 758 } ;# ok
atomselect macro BBulge  {resid 239 to 260} ;#ok
atomselect macro Linker  {resid 441 to 448} ;#ok
atomselect macro Beta5   {resid 448 to 450} ;#ok
atomselect macro HGHelix {resid 211 to 217}
atomselect macro Transducer {Loop1 or HGHelix or BBulge or Linker or Beta5}

############################## additional macros (mine) ###########

#atomselect macro SH3Loop {resid 7 to 13}
#atomselect macro U50Loop1 {resid 295 to 301}
#atomselect macro U50Loop2 {resid 288 to 295} 
#atomselect macro U50Loop3 {resid 251 to 255}

#atomselect macro NLoop1 {resid 666 to 674}
#atomselect macro NLoop2 {resid 64 to 81}

atomselect macro TransHelix {resid 211 to 217}

atomselect macro NtHelix {resid 186 to 198}

#atomselect macro Aloop { resid 110 to 117 } ;# coordinates the adenosine moiety

