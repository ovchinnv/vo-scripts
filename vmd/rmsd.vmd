#!/bin/tclsh
#set name rpol-rna
#puts $argv
#puts $argc

if { $argc <= 0 } {
 exit;
} else {
 set name [lindex $argv 0];
 if {$argc >= 1 } {
  set step [lindex $argv 1];
 } else { ;#1
  set step 1;
 }
}
#
mol delete all
mol load psf struc/${name}sn.psf
mol addfile struc/${name}_msn.cor
#
set dcds [exec ls scratch | grep ${name} | grep dcd | sort -V ] ;# complete dcd files
#
foreach dcd $dcds {
 puts $dcd
 mol addfile scratch/$dcd waitfor all step $step
}
#exit
#set itraj 0
#set etraj 13
#set flag eq
#for {set i $itraj } { $i <= $etraj } {incr i} {
# if {$i >= 6 } { set flag npt }
# if {$i >=1 } { set flag nvt }
# mol addfile scratch/${name}${i}${flag}.dcd waitfor all step $step
#}

set outdcd [lindex [exec ls | grep output] 0 ] ;# partial dcd file
mol addfile $outdcd waitfor all step $step

set id [ molinfo top ];
set nf [molinfo $id get numframes];
#set selection "protein or resname GTP or resname MG"
set orientation "protein" ;
set orientation "segname \"NP.*\"" ;
#set orientation "protein or nucleic" ;
#set orientation "segid H11"
#set orientation "segname \"C6.*\""
#set orientation "protein or ( segid TPP and name P1 )"
#set rms "protein" ;
#set rms "nucleic" ;
set rms $orientation
#set rms "segid CTP"

#set cons "beta 1 and backbone"
set cons "beta 1"
set cons "noh"
set cons "backbone"
#set cons "name CA"

puts $cons
set all      [atomselect $id all];
set orient   [atomselect $id "$orientation and $cons"]
set template [atomselect $id "$orientation and $cons" frame 0] 
set rmsd     [atomselect $id "$rms and $cons"]
set ref      [atomselect $id "$rms and $cons" frame 0] 
#
puts "[$orient num] atoms selected for orientation ...\n";
#
set fid [open "rmsd.dat" w+];
set rms_ {};
#
for { set i 0 } { $i<$nf } { incr i } {
 $orient frame $i
# $orient update
 $rmsd frame $i
# $rmsd update
 $all frame $i
# $all update
 $all move [measure fit $orient $template]
 set r [measure rmsd $rmsd $ref];
 lappend rms_ $r
 puts $fid "$r"
}
close $fid
#
puts ${rms_}
