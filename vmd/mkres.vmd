#!/bin/vmd

if { $argc > 0 } {
 set name [lindex $argv 0];
} else {
 if { ![info exists "path"] } {
  set path "$env(HOME)/scripts/vmd"
 }
 source ${path}/gname.tcl
}

mol load psf ${name}_sn.psf
mol addfile ${name}_msn.pdb

# mark restraints

set all [atomselect top "all" ];
$all set beta 0

# need artifice below to tupport blanks within arguments
if { [ info exists env(VMDSEL)] } {
 set selection $env(VMDSEL)
} else {
 set selection " protein and noh "
}
#
if { [ info exists env(VMDTAG)] } {
 set nametag $env(VMDTAG)
} else {
 set nametag "res"
}
puts $selection
puts $nametag

set res [atomselect top "$selection" ];
$res set beta 1 ;

$all writepdb ${name}-${nametag}.pdb
# note : may need to remove the unit cell line from this pdb if running without PBC :
exec sed -i /CRYST/d ${name}-${nametag}.pdb
