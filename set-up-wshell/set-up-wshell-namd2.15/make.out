file=tsp.mod ; \
dir=../ ; \
if [ -f $file ] ; then mv -f $file ../tsp.mod 2>/dev/null; touch -m ../tsp.mod 2>/dev/null; else \
FILE=`echo ${file%.*} | tr '[:lower:]' '[:upper:]'`.mod ; \
if [ -f $FILE ] ; then mv -f $FILE $dir/$FILE 2>/dev/null; \
touch -m $dir/$FILE 2>/dev/null;\
fi ; fi
