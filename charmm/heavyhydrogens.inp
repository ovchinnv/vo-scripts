* Change masses to heavy hydrogens
*

! Read FF topology and parameters
stream /home/simone/opt/ff/charmmff.str

! Read psf and cor
read psf  card name minimized.psf
read coor card name minimized.cor

! Get all hydrogens for the whole system
define all_h sele hydrogen end

! Loop over all hydrogens
set n ?NSEL
set i 1
label loop_h

    ! Get this hydrogen
    define this_h sele all_h .subset. @i end 

    ! Get the atom bonded to this hydrogen
    define bonded sele .bonded. this_h end

    ! Increase mass of the hydrogen to 4
    scalar mass stat sele this_h end
    calc newmass = ?SAVE + 3.0
    scalar mass set @newmass sele this_h end

    ! Decrease bonded atom mass by 3
    scalar mass stat sele bonded end
    calc newmass = ?SAVE - 3.0
    scalar mass set @newmass sele bonded end

increment i by 1
if @i .le. @n goto loop_h

! Write modified psf
write psf card name heavyhydrogens.psf

stop


