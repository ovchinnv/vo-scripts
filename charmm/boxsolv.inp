* protein solvation component
*

if @?clib eq 0 set clib ~/scripts/charmm

!set adpar ../inhib/@{drugfile}/@{drugfile}i
!set cgenff

if @?version eq 0 set version 36

if @?nopar eq 0 set nopar 0
if @nopar ne 0 goto skippar

if @version eq 36 then
 stream @{clib}/readpsf36.str
else
 stream @{clib}/readpsf.str
endif

label skippar

if @?buf eq 0 set buf 11.  ! solvation radius

if @?solute eq 0 set solute all
define solute select ( @solute ) end
coor orie select solute end ! align 
coor stat select solute end ! select the active site region

! compute center of water box
if @?xmin eq 0 calc xmin = ?xmin
if @?ymin eq 0 calc ymin = ?ymin
if @?zmin eq 0 calc zmin = ?zmin
if @?xmax eq 0 calc xmax = ?xmax
if @?ymax eq 0 calc ymax = ?ymax
if @?zmax eq 0 calc zmax = ?zmax
if @?solute eq 0 set solute all
define solute select ( @solute ) end
update atom cutnb 15 ctonnb 10 ctofnb 12 vdw vshift fshift cdie

nobomb
if @?cube eq 1 set method cube ! backward compatibility
if @?overlap eq 0 set overlap 2.5
if @?method eq 0 set method box

if @method eq BOX then
 stream @{clib}/wboxfast.str
else
 if @method eq CUBE then
  stream @{clib}/wcubefast.str
 else
  if @method eq SHELL then
   stream @{clib}/wshell.str
  else
   if @method eq BALL then
    stream @{clib}/wball.str
   else
    if @method eq SPHERE then
     stream @{clib}/wball.str
    else
     echo "METHOD @{METHOD} NOT RECOGNIZED. AVALABLE METHODS ARE BOX, CUBE, SHELL, BALL"
    endif
   endif
  endif
 endif
endif

rename segid wat select segid w* end ! rename all waters

if @?skipmini ne 0 -
goto write ! skip minimization

cons harm force 30 select solute .and. .not. hydrogen end
! cons fix select onlysolute .and. .not. hydrogen end
! mini sd nstep 100
mini conj nstep 10
mini abnr nstep 10
 
label unconstrained_mini ! no constraints in reaction zone 
cons harm clear
mini conj nstep 10
minimize abnr nstep 10


label skipmini
energy

label write

! shift corner to origin
coor stat
scalar X add -?XMIN
scalar Y add -?YMIN
scalar Z add -?ZMIN

write psf @format name @{psffile}_s.psf
write psf @format name @{psffile}_s-x.psf xplor
!
if @?corfile ne 0 then
 write coord @format name @{corfile}s.cor
 write coord pdb name @{corfile}s.pdb
else
 write coord @format name @{pdbfile}s.cor
 write coord pdb name @{pdbfile}s.pdb
endif
!* solvated in a box of dimension
!* xmin=@xmi ymin=@ymi zmin=@zmi 
!* xmax=@xma ymax=@yma zmax=@zma 
!*
!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
open write card unit 66 name @{psffile}.str
if @method eq SHELL then
write title unit 66
** solvated in a watershell of thickness
* set a @maxdist

else
 if @method eq BALL then
 write title unit 66
** Solvated in a sphere of radius and center
* set R @R
* set xcen @xcen
* set ycen @ycen
* set zcen @zcen

 else
  if @method eq SPHERE then
 write title unit 66
** Solvated in a sphere of radius and center
* set R @R
* set xcen @xcen
* set ycen @ycen
* set zcen @zcen

  else
write title unit 66
** solvated in an orthorhombic box of the following dimensions
* set a  @xl
* set b  @yl
* set c  @zl
* set alpha 90.0
* set beta 90.0
* set gamma 90.0

  endif
 endif
endif
close unit 66

!!!! STOP HERE !!!!!!!!!!!

goto kill

!!!!!!!!! FINISHED !!!!!!!!!!!!

label kill
return
